# Full canonical origin, no trailing slash. Use http://127.0.0.1:3000 locally.
SITE_URL=http://127.0.0.1:3000

# User-selected default: email. Set to supabase only when storage is configured.
INQUIRY_MODE=email

# Server-only Supabase project URL and secret key. Never use NEXT_PUBLIC_ for secrets.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random secret of at least 32 characters, used to pseudonymize rate-limit identifiers.
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
